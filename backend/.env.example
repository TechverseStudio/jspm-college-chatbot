# JSPM College Chatbot - Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Path (SQLite with FTS5)
DATABASE_PATH=data/knowledge.db
SEED_DOCUMENT_PATH=data/JSPM_RSCOE_College_Chatbot_Knowledge_Base.md

# Admin Security Token
ADMIN_API_KEY=jspm_admin_secret_key_2026

# Allowed CORS Origins (Include Android app emulator and LAN addresses)
CORS_ORIGINS=["*"]

# AI Integration Configuration (Optional)
# Supported AI_PROVIDER values: "none" (default, deterministic retrieval-only), "openai", "gemini", "anthropic", "custom"
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Scraper Settings
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_DEPTH=2
